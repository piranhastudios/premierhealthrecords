# /etc/phr/backup.env  (root:jake 0640) — read by phr-backup
# age public key (age1...). Generate the pair OFF this box: `age-keygen -o phr-backup.key`,
# keep phr-backup.key in the password manager, paste only the public key here.
AGE_RECIPIENT=
# rclone remote for off-site copies, e.g. a Hetzner Storage Box over sftp:
#   rclone config --config /etc/phr/rclone.conf   (name it "storagebox")
RCLONE_REMOTE=
RCLONE_CONFIG=/etc/phr/rclone.conf
# healthchecks.io dead-man's switches (one check per env; period 1 day / 1 week, grace 2h)
HC_PING_URL_PROD=
HC_PING_URL_DEV=
KEEP_DAYS_PROD=30
KEEP_DAYS_DEV=7
