# /etc/phr/smoke-<env>.env  (root:jake 0640) — optional deeper smoke test after each deploy.
# Use a dedicated low-privilege practitioner login, never a real clinician's.
SMOKE_EMAIL=
SMOKE_PASSWORD=
SMOKE_PROJECT_ID=
# dev only: also create, cancel and delete an Appointment. Never set for prod.
SMOKE_WRITE=0
