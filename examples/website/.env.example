NEXT_PUBLIC_SANITY_PROJECT_ID=ciwnv4el
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-06
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
SANITY_API_READ_TOKEN=

# Preview deployments only: render unpublished drafts site-wide (needs the read token above).
SANITY_SHOW_DRAFTS=false

# Online booking. The website reads doctors/services per site from Medplum
# (server side, scoped client from scripts/seed-website-client.mjs), books through
# Medplum ($find / $book) and takes the booking fee before confirming.
#
# BOOKING_ENABLED is the master switch and is OPT-IN: anything other than
# true/1/on/yes (including unset) turns booking off, and the booking dialog shows
# the clinic phone number instead. The API routes return 503 when it is off, so it
# cannot be driven directly either. Credentials alone never enable booking.
BOOKING_ENABLED=false
MEDPLUM_BASE_URL=https://app.premierhealthcentres.com/api/
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=

# Shared secret for /api/revalidate, which clears the cached Sanity content.
# Point a Sanity webhook at https://<site>/api/revalidate?secret=... so that
# publishing reaches visitors (see the route for the full setup).
SANITY_REVALIDATE_SECRET=
