    "@tanstack/react-query": "5.62.7",
    "expo": "~54.0.0",
    "expo-auth-session": "~7.0.0",
    "expo-build-properties": "~1.0.0",
    "expo-camera": "~17.0.0",
    "expo-constants": "~18.0.0",
    "expo-crypto": "~15.0.0",
    "expo-dev-client": "~6.0.0",
