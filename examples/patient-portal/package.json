{
  "name": "patient-portal",
  "version": "5.1.9",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "eas-build-post-install": "npx turbo run build --filter=@medplum/core --filter=@medplum/react-hooks",
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "echo \"patient-portal: run 'expo lint' locally after 'npx expo install'\"",
    "typecheck": "tsc --noEmit",
    "test": "echo \"patient-portal: no tests yet (jest-expo)\""
  },
  "dependencies": {
