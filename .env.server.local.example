# Local FHIR-server config overrides (copy to .env.server.local — git-ignored).
# The server dev script loads config as "file:medplum.config.json,env", so any
# MEDPLUM_* variable here overrides the checked-in config without committing secrets.
#
# Outbound email via Resend SMTP — makes admin invites / password resets send in dev.
# The from address (MEDPLUM_SUPPORT_EMAIL) must be a sender on a domain verified in
# Resend, and the password is your Resend API key (same one the messaging bots use).
MEDPLUM_SMTP_HOST=smtp.resend.com
MEDPLUM_SMTP_PORT=587
MEDPLUM_SMTP_USERNAME=resend
MEDPLUM_SMTP_PASSWORD=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
MEDPLUM_SUPPORT_EMAIL="Premier Health <care@premierhealthcentres.com>"
