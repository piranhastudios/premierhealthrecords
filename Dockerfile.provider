# Self-contained, from-source build of the medplum-provider app for self-hosting
# (Coolify / plain docker compose). Builds the Vite app from the FULL monorepo
# workspace so the LOCAL @medplum/* packages (Premier Health branding in
# packages/react, telehealth UI, etc.) are baked in. Building examples/medplum-provider
# in isolation pulls @medplum/react from npm and drops those customizations.

# Stage 1: build the provider (and its workspace deps) from source.
FROM node:24-bookworm-slim AS build
WORKDIR /usr/src/medplum

# Vite inlines these at build time; real values come from Coolify build args.
ARG VITE_MEDPLUM_BASE_URL=https://app.premierhealthcentres.com/api/
ARG VITE_TURN_URL=
ARG VITE_TURN_USERNAME=
ARG VITE_TURN_CREDENTIAL=
ENV VITE_MEDPLUM_BASE_URL=${VITE_MEDPLUM_BASE_URL} \
    VITE_TURN_URL=${VITE_TURN_URL} \
    VITE_TURN_USERNAME=${VITE_TURN_USERNAME} \
    VITE_TURN_CREDENTIAL=${VITE_TURN_CREDENTIAL}

COPY . .
RUN npm ci
# Build dist for the @medplum workspace packages in the provider's runtime graph
# via esbuild (NOT the packages' full `build`, whose `tsc` step type-checks test
# files — one imports react-router-dom, not a dep, and fails on a clean install).
# esbuild bundles from src without type-checking. The provider's vite build reads
# directly-used packages from /src via config aliases, but their transitive,
# non-aliased imports (e.g. @medplum/dosespot-core, pulled in by dosespot-react)
# resolve to these dists. Building react here also emits dist/esm/index.css, which
# the provider imports as '@medplum/react/styles.css'.
RUN set -eux; for p in core react-hooks react fhir-router mock \
      dosespot-core dosespot-react scriptsure-react \
      health-gorilla-core health-gorilla-react campaigns; do \
      if [ -f "packages/$p/esbuild.mjs" ]; then ( cd "packages/$p" && node esbuild.mjs ); fi; \
    done
# Build the provider with vite directly. Its npm `build` is `tsc && vite build`;
# we skip tsc (vite transpiles without a full typecheck). Vite resolves every
# @medplum/* import to local source via the config aliases, baking in the Premier
# Health branding. VITE_* are read from the build env set above.
RUN cd examples/medplum-provider && npx vite build

# Stage 2: serve the static SPA via nginx on port 80 (SPA fallback for react-router).
FROM nginx:alpine
COPY --from=build /usr/src/medplum/examples/medplum-provider/dist /usr/share/nginx/html
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  index index.html;\n  location / {\n    try_files $uri $uri/ /index.html;\n  }\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 80
